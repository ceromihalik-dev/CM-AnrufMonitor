<Window x:Class="CM.AnrufMonitor.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="CM AnrufMonitor" Icon="Assets/app.ico" Style="{StaticResource {x:Type Window}}" Width="980" Height="790" MinWidth="800" MinHeight="550"
 WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
 Loaded="Window_Loaded" Closing="Window_Closing" LocationChanged="Window_BoundsChanged" SizeChanged="Window_BoundsChanged">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="0" /></shell:WindowChrome.WindowChrome>
 <Border BorderBrush="#77A8E8" BorderThickness="1">
  <Grid x:Name="RootGrid" Margin="24,18,24,12">
   <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
   <Border Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown" Padding="0,0,0,19">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
     <Border x:Name="BrandMark" Width="45" Height="45" CornerRadius="11" Background="{StaticResource YellowBrush}" Margin="0,0,13,0">
      <Grid><Path Stroke="#174D8B" StrokeThickness="2.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M 13,10 C 8,12 10,23 17,30 C 24,37 35,37 35,31 L 29,26 25,29 C 20,26 17,23 16,19 L 19,15 Z" Width="30" Height="31" Stretch="Uniform" /></Grid>
     </Border>
     <StackPanel Grid.Column="1" VerticalAlignment="Center">
      <TextBlock x:Name="BrandTitle" Text="CM AnrufMonitor" FontSize="24" FontWeight="SemiBold" />
      <TextBlock x:Name="BrandSubtitle" Text="Deine Anrufe. Direkt auf dem Desktop." Style="{StaticResource MutedText}" Margin="0,3,0,0" />
     </StackPanel>
     <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
      <Button x:Name="HeaderWidgetButton" Content="◱  Widget" Click="ToggleCompact_Click" Margin="0,4,12,0" Style="{StaticResource SmallButton}" ToolTip="Zum kompakten Desktop-Fenster wechseln" />
      <Button x:Name="MinimizeButton" Content="—" Click="Minimize_Click" Width="30" Padding="0" Margin="0,4,4,0" Style="{StaticResource SmallButton}" ToolTip="Minimieren" />
      <Button x:Name="MaximizeButton" Content="□" Click="Maximize_Click" Width="30" Padding="0" Margin="0,4,4,0" Style="{StaticResource SmallButton}" ToolTip="Maximieren / wiederherstellen" />
      <Button Content="×" Click="Hide_Click" Width="30" Padding="0" Margin="0,4,0,0" Style="{StaticResource SmallButton}" ToolTip="In den Infobereich minimieren; die Anrufanzeige läuft weiter" />
     </StackPanel>
    </Grid>
   </Border>

   <Border x:Name="WarningBanner" Grid.Row="1" Background="#CC7A202B" CornerRadius="7" Padding="12,10" Margin="0,0,0,13" Visibility="Collapsed">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="WarningText" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" /></ScrollViewer><Button Content="×" Grid.Column="1" Click="DismissWarning_Click" Padding="6,0" MinHeight="24" Margin="8,0,0,0" ToolTip="Hinweis schließen" /></Grid>
   </Border>

   <Grid x:Name="FullContent" Grid.Row="2">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid Margin="0,0,0,16">
     <Grid.ColumnDefinitions><ColumnDefinition Width="2.2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
     <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,11,0">
      <StackPanel><DockPanel><Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="#FFE23A" Margin="0,0,8,0" DockPanel.Dock="Left" /><TextBlock x:Name="ConnectionTitle" Text="Noch nicht verbunden" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" /></DockPanel><TextBlock x:Name="ConnectionHost" Text="fritz.box · Port 1012" Style="{StaticResource MutedText}" Margin="16,7,0,0" TextTrimming="CharacterEllipsis" /></StackPanel>
     </Border>
     <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14,9" Margin="0,0,11,0"><StackPanel><TextBlock Text="EINGEHEND HEUTE" FontSize="10" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="IncomingCount" Text="0" FontSize="27" FontWeight="SemiBold" /></StackPanel></Border>
     <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,9" Margin="0,0,11,0"><StackPanel><TextBlock Text="AUSGEHEND HEUTE" FontSize="10" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="OutgoingCount" Text="0" FontSize="27" FontWeight="SemiBold" /></StackPanel></Border>
     <Border Grid.Column="3" Style="{StaticResource Card}" Padding="14,9"><StackPanel><TextBlock Text="VERPASST HEUTE" FontSize="10" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="MissedCount" Text="0" FontSize="27" FontWeight="SemiBold" Foreground="#FFAFB3" /></StackPanel></Border>
    </Grid>

    <Border Grid.Row="1" Background="#23112F61" BorderBrush="#55BBD9FF" BorderThickness="1" CornerRadius="12" Padding="20,15" Margin="0,0,0,13">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel>
       <StackPanel Orientation="Horizontal"><TextBlock x:Name="HeroState" Text="BEREIT FÜR DEN ERSTEN ANRUF" FontSize="10" FontWeight="Bold" Foreground="{StaticResource YellowBrush}" /><TextBlock x:Name="ActiveCountText" Text="" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="14,0,0,0" /></StackPanel>
       <TextBlock x:Name="HeroName" Text="Verbinde deine FRITZ!Box" FontSize="25" FontWeight="SemiBold" Margin="0,8,0,3" TextTrimming="CharacterEllipsis" />
       <TextBlock x:Name="HeroNumber" Text="Anrufmonitor am Telefon mit #96*5* einschalten." FontSize="14" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
       <TextBlock x:Name="HeroDetails" Text="Anschließend unter Einrichtung auf „Verbinden“ klicken." FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="18,0,0,0">
       <TextBlock x:Name="HeroDuration" Text="" FontSize="26" FontWeight="Light" HorizontalAlignment="Right" Margin="0,0,0,9" />
       <Button x:Name="CopyHeroButton" Content="Nummer kopieren" Click="CopyHero_Click" Style="{StaticResource SmallButton}" IsEnabled="False" />
       <Button x:Name="ReverseHeroButton" Content="Rückwärtssuche ↗" Click="ReverseHero_Click" Style="{StaticResource SmallButton}" Margin="0,6,0,0" IsEnabled="False" ToolTip="Deutsche Rufnummer bei Das Örtliche im Browser suchen. Nur beim Klick wird die angezeigte Nummer an den Anbieter übermittelt." />
      </StackPanel>
     </Grid>
    </Border>

    <TabControl x:Name="MainTabs" Grid.Row="2">
     <TabItem Header="Anrufverlauf">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
       <Grid Margin="0,0,0,11"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBox x:Name="SearchBox" TextChanged="Filter_Changed" ToolTip="Nach Name, Rufnummer oder eigener Rufnummer suchen" Margin="0,0,9,0" />
        <ComboBox x:Name="FilterBox" Grid.Column="1" SelectionChanged="Filter_Changed" SelectedIndex="0" Margin="0,0,9,0"><ComboBoxItem Content="Alle Anrufe" /><ComboBoxItem Content="Verpasst" /><ComboBoxItem Content="Eingehend" /><ComboBoxItem Content="Ausgehend" /></ComboBox>
        <Button Grid.Column="2" Content="CSV exportieren" Click="Export_Click" Margin="0,0,8,0" />
        <Button Grid.Column="3" Content="Leeren" Click="ClearHistory_Click" ToolTip="Gespeicherten Verlauf nach Bestätigung leeren" />
       </Grid>
       <Border Grid.Row="1" CornerRadius="8" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" ClipToBounds="True">
        <Grid>
         <DataGrid x:Name="HistoryGrid" SelectionChanged="History_SelectionChanged" MouseDoubleClick="History_DoubleClick" ToolTip="Doppelklick auf einen Eintrag zeigt alle Anrufdetails.">
          <DataGrid.Columns>
           <DataGridTextColumn Header="STATUS" Binding="{Binding StateText}" Width="122"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding StateBrush}" /></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
           <DataGridTextColumn Header="ZEIT" Binding="{Binding TimeText}" Width="113" />
           <DataGridTextColumn Header="KONTAKT" Binding="{Binding Name}" Width="*" MinWidth="120" />
           <DataGridTextColumn Header="RUFNUMMER" Binding="{Binding Number}" Width="142" />
           <DataGridTextColumn Header="EIGENE NR." Binding="{Binding LocalNumber}" Width="123" />
           <DataGridTextColumn Header="DAUER" Binding="{Binding Duration}" Width="69" />
          </DataGrid.Columns>
          <DataGrid.ContextMenu><ContextMenu><MenuItem Header="Rufnummer kopieren" Click="CopySelected_Click" /><MenuItem Header="Rückwärtssuche bei Das Örtliche …" Click="ReverseSelected_Click" /><MenuItem Header="Als Kontakt übernehmen" Click="ContactFromCall_Click" /><MenuItem Header="Details anzeigen" Click="ShowDetails_Click" /></ContextMenu></DataGrid.ContextMenu>
         </DataGrid>
         <StackPanel x:Name="EmptyHistory" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="20">
          <TextBlock x:Name="EmptyHistoryTitle" Text="Hier erscheinen deine Anrufe" FontSize="19" HorizontalAlignment="Center" />
          <TextBlock x:Name="EmptyHistorySubtitle" Text="Der Verlauf beginnt, sobald die Verbindung aktiv ist." Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap" />
         </StackPanel>
        </Grid>
       </Border>
       <TextBlock x:Name="HistoryFooter" Grid.Row="2" Text="Suche: Name oder Rufnummer eingeben. Nur während der Überwachung erfasste Anrufe." Style="{StaticResource MutedText}" FontSize="10" Margin="2,9,0,0" TextWrapping="Wrap" />
      </Grid>
     </TabItem>
     <TabItem Header="Kontakte">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
       <TextBlock x:Name="ContactSourceInfo" Text="Eigene Kontakte haben Vorrang. Zusätzlich können FRITZ!Box-Telefonbücher automatisch geladen werden." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap" />
       <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,9,0"><TextBlock Text="NAME" FontSize="10" Margin="0,0,0,4" /><TextBox x:Name="ContactNameBox" /></StackPanel>
        <StackPanel Grid.Column="1" Margin="0,0,9,0"><TextBlock Text="RUFNUMMER" FontSize="10" Margin="0,0,0,4" /><TextBox x:Name="ContactNumberBox" /></StackPanel>
        <Button x:Name="SaveContactButton" Grid.Column="2" Content="Kontakt hinzufügen" Click="SaveContact_Click" Style="{StaticResource AccentButton}" VerticalAlignment="Bottom" />
       </Grid>
       <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True"><DataGrid x:Name="ContactsGrid" SelectionChanged="Contact_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="*" /><DataGridTextColumn Header="RUFNUMMER" Binding="{Binding Number}" Width="220" /></DataGrid.Columns></DataGrid></Border>
       <DockPanel Grid.Row="3" Margin="0,11,0,0"><WrapPanel DockPanel.Dock="Left"><Button Content="FRITZ!Box-Telefonbuch importieren" Click="ImportFritz_Click" Margin="0,0,8,0" /><Button Content="CSV importieren" Click="ImportCsv_Click" Margin="0,0,8,0" /><Button Content="Neu" Click="NewContact_Click" Margin="0,0,8,0" /><Button Content="Entfernen" Click="RemoveContact_Click" /></WrapPanel><TextBlock x:Name="ContactsCount" Text="0 Kontakte" Style="{StaticResource MutedText}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0" /></DockPanel>
      </Grid>
     </TabItem>
     <TabItem Header="Einrichtung">
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,13,8">
       <Border Style="{StaticResource Card}" Margin="0,0,0,13"><StackPanel>
        <TextBlock Text="Mit der FRITZ!Box verbinden" Style="{StaticResource SectionTitle}" />
        <TextBlock Text="1  Am direkt angemeldeten Telefon #96*5* wählen.&#x0a;2  Diesen PC mit demselben Heimnetz verbinden.&#x0a;3  Adresse prüfen und auf „Verbinden“ klicken." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" LineHeight="23" Margin="0,0,0,14" />
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
         <StackPanel Margin="0,0,10,0"><TextBlock Text="FRITZ!BOX-ADRESSE" FontSize="10" Margin="0,0,0,5" /><TextBox x:Name="HostBox" Text="fritz.box" ToolTip="Hostname oder IP-Adresse ohne http:// und ohne Port, beispielsweise 192.168.178.1" /></StackPanel>
         <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="TCP-PORT" FontSize="10" Margin="0,0,0,5" /><TextBox x:Name="PortBox" Text="1012" MaxLength="5" /></StackPanel>
         <Button x:Name="ConnectButton" Grid.Column="2" Content="Verbinden" Click="Connect_Click" Style="{StaticResource AccentButton}" VerticalAlignment="Bottom" Margin="0,0,9,0" />
         <Button Grid.Column="3" Content="Demo anzeigen" Click="Demo_Click" VerticalAlignment="Bottom" ToolTip="Zeigt einen simulierten Anruf ohne FRITZ!Box. Kein Eintrag im echten Verlauf." />
        </Grid>
        <TextBlock x:Name="ConnectionDetail" Text="Noch nicht verbunden. Für die Live-Anzeige wird kein Passwort benötigt." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" />
        <CheckBox x:Name="AutoConnectBox" Content="Beim nächsten Programmstart automatisch verbinden" />
       </StackPanel></Border>
       <Border Style="{StaticResource Card}" Margin="0,0,0,13"><StackPanel>
        <TextBlock Text="Anrufliste und Telefonbücher abgleichen" Style="{StaticResource SectionTitle}" />
        <TextBlock Text="Lädt auch Anrufe, die bei ausgeschaltetem PC eingegangen sind. Die FRITZ!Box muss den Zugriff für Anwendungen (TR-064) erlauben; der Benutzer benötigt Telefonie-/Anruflistenrechte." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" LineHeight="20" Margin="0,0,0,7" />
        <CheckBox x:Name="FritzSyncEnabledBox" Content="Automatischen FRITZ!Box-Abgleich aktivieren" />
        <Grid Margin="0,7,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
         <StackPanel Margin="0,0,10,0"><TextBlock Text="FRITZ!BOX-BENUTZER" FontSize="10" Margin="0,0,0,5" /><TextBox x:Name="FritzUsernameBox" MaxLength="256" /></StackPanel>
         <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="KENNWORT" FontSize="10" Margin="0,0,0,5" /><PasswordBox x:Name="FritzPasswordBox" MaxLength="4096" ToolTip="Leer lassen, um das bereits gespeicherte Kennwort beizubehalten. Ein neu eingetragenes Kennwort ersetzt es erst beim Speichern." /></StackPanel>
         <StackPanel Grid.Column="2"><TextBlock Text="TR-064-PORT" FontSize="10" Margin="0,0,0,5" /><TextBox x:Name="FritzPortBox" Text="49000" MaxLength="5" /></StackPanel>
        </Grid>
        <TextBlock x:Name="CredentialStatus" Text="Noch kein Kennwort gespeichert." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,3" />
        <CheckBox x:Name="SyncPhonebooksBox" Content="FRITZ!Box-Telefonbücher zur Namenserkennung laden" IsChecked="True" />
        <WrapPanel Margin="0,5,0,9"><Button Content="Zugang speichern" Click="SaveFritzAccess_Click" Style="{StaticResource AccentButton}" Margin="0,0,8,6" /><Button x:Name="TestFritzButton" Content="Verbindung testen" Click="TestFritz_Click" Margin="0,0,8,6" /><Button x:Name="SyncNowButton" Content="Jetzt abgleichen" Click="SyncNow_Click" Margin="0,0,8,6" /><Button Content="Kennwort löschen" Click="ForgetFritzPassword_Click" Margin="0,0,0,6" /></WrapPanel>
        <TextBlock x:Name="FritzSyncStatus" Text="Abgleich ist ausgeschaltet." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" />
        <TextBlock x:Name="LastSyncText" Text="Noch kein erfolgreicher Abgleich." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,7,0,0" />
        <TextBlock Text="Das Kennwort wird mit Windows-DPAPI für dein Benutzerkonto geschützt gespeichert. Die Verbindung zur Box nutzt HTTP-Digest im Heimnetz (standardmäßig Port 49000); die abgerufenen Inhalte sind dabei nicht TLS-verschlüsselt." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="10" LineHeight="17" Margin="0,10,0,0" />
       </StackPanel></Border>
       <Border Style="{StaticResource Card}" Margin="0,0,0,13"><StackPanel>
        <TextBlock Text="Desktop und Benachrichtigungen" Style="{StaticResource SectionTitle}" />
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><CheckBox x:Name="AlwaysOnTopBox" Content="Fenster immer im Vordergrund halten" /><CheckBox x:Name="NotificationsBox" Content="Bei eingehendem Anruf benachrichtigen" /></StackPanel><StackPanel Grid.Column="1"><CheckBox x:Name="StartWithWindowsBox" Content="Mit Windows starten" /><TextBlock Text="Beim Schließen läuft die App im Infobereich weiter.&#x0a;Über das Symbol neben der Uhr: Anzeigen oder Beenden." FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" /></StackPanel></Grid>
        <DockPanel Margin="0,13,0,0"><TextBlock Text="Deckkraft" VerticalAlignment="Center" Margin="0,0,15,0" /><TextBlock x:Name="OpacityText" DockPanel.Dock="Right" Text="100 %" Width="52" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0" /><Slider x:Name="OpacitySlider" Minimum="70" Maximum="100" Value="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OpacitySlider_ValueChanged" VerticalAlignment="Center" /></DockPanel>
       </StackPanel></Border>
       <Border Style="{StaticResource Card}" Margin="0,0,0,13"><StackPanel><TextBlock Text="Rufnummern richtig zuordnen" Style="{StaticResource SectionTitle}" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="LANDESVORWAHL" FontSize="10" Margin="0,0,0,5" /><TextBox x:Name="CountryCodeBox" Text="+49" /></StackPanel><StackPanel Grid.Column="1" Margin="0,0,18,0"><TextBlock Text="ORTSVORWAHL (OPTIONAL)" FontSize="10" Margin="0,0,0,5" /><TextBox x:Name="AreaCodeBox" /></StackPanel><TextBlock Grid.Column="2" Text="Beispiel: +49 und 030. So passen +49 30 … und 030 … zum selben Kontakt." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Bottom" /></Grid></StackPanel></Border>
       <StackPanel Orientation="Horizontal"><Button Content="Einstellungen speichern" Click="SaveSettings_Click" Style="{StaticResource AccentButton}" /><TextBlock x:Name="SettingsSavedText" Text="" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{StaticResource YellowBrush}" /></StackPanel>
      </StackPanel></ScrollViewer>
     </TabItem>
     <TabItem Header="Hilfe &amp; Info">
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,15">
       <TextBlock Text="Eine kleine Anzeige. Alle Anrufe im Blick." FontSize="21" FontWeight="SemiBold" Margin="0,0,0,12" />
       <TextBlock Text="CM AnrufMonitor zeigt die Live-Meldungen deiner FRITZ!Box an: eingehende, ausgehende, angenommene und verpasste Gespräche. Über „Widget“ wird daraus ein kompaktes, frei verschiebbares Fenster." TextWrapping="Wrap" LineHeight="21" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,18" />
       <TextBlock Text="Einmalig freischalten" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,7" />
       <TextBlock Text="An einem direkt mit der FRITZ!Box verbundenen DECT-, Analog- oder ISDN-Telefon #96*5* wählen. Ein DECT-Telefon sollte direkt an der Box angemeldet sein. Zum Ausschalten #96*4* wählen. Die App verwendet TCP-Port 1012 im Heimnetz; eine Internet-Portfreigabe ist nicht erforderlich. Der Live-Dienst überträgt Rufnummern unverschlüsselt und ohne Anmeldung im lokalen Netz." TextWrapping="Wrap" LineHeight="21" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,18" />
       <TextBlock Text="Wenn keine Verbindung zustande kommt" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,7" />
       <TextBlock Text="Prüfe die Freischaltung, die Box-Adresse und das Heimnetz. Im Gastnetz ist die Box normalerweise nicht erreichbar. Wenn fritz.box nicht aufgelöst wird, verwende ihre lokale IP-Adresse. Die App verbindet sich nach einem Ausfall automatisch erneut. Bei einer Unterbrechung werden laufende Einträge als „Unvollständig“ gespeichert, damit daraus keine falschen verpassten Anrufe werden." TextWrapping="Wrap" LineHeight="21" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,18" />
       <TextBlock Text="Kontaktnamen anzeigen" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,7" />
       <TextBlock Text="Mit aktiviertem FRITZ!Box-Abgleich lädt die App die Telefonbücher der Box und frischt sie alle sechs Stunden sowie bei „Jetzt abgleichen“ auf. Eigene, unter Kontakte angelegte oder importierte Einträge haben Vorrang. Danach gelten die Namen aus dem FRITZ!Box-Telefonbuch, anschließend Namen aus der Anrufliste. Für die Rückwärtssuche öffnet ein ausdrücklicher Klick „Das Örtliche“ im Browser und übermittelt diese Rufnummer. Es gibt keine automatische Internetabfrage und keine automatische Übernahme von Internetnamen." TextWrapping="Wrap" LineHeight="21" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,18" />
       <TextBlock Text="Ältere Anrufe und Namen abgleichen" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,7" />
       <TextBlock Text="Unter Einrichtung den automatischen Abgleich aktivieren und den FRITZ!Box-Benutzer sowie sein Kennwort speichern. Der Abgleich läuft beim Programmstart, nach Wiederverbindung, regelmäßig alle fünf Minuten und kurz nach einem Gesprächsende. Bereits vorhandene Anrufe werden abgeglichen; laufende Gespräche bleiben bestehen. Aus der Box stammende Gesprächsdauern sind teilweise auf Minuten gerundet. Die Box kann nur Einträge liefern, die sie selbst noch gespeichert hat. Auch ohne aktiven Live-Anrufmonitor kann der Listenabgleich funktionieren." TextWrapping="Wrap" LineHeight="21" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,18" />
       <TextBlock Text="Was die Anzeige bedeutet" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,7" />
       <TextBlock Text="Ohne Listenabgleich enthält der Verlauf nur empfangene Live-Meldungen. Interne Gespräche erscheinen je nach Schnittstelle nicht. „Verpasst“ bedeutet bei Live-Anrufen: Klingeln gesehen, aber keine Annahme gemeldet. Eine Annahme durch Anrufbeantworter oder ein anderes Telefon kann als angenommen erscheinen. Die App dient zur Anzeige; telefoniert wird weiterhin am Telefon. Ein zugeordneter Name ist keine Prüfung der Identität des Anrufers." TextWrapping="Wrap" LineHeight="21" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,18" />
       <TextBlock Text="Daten und Programm" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,7" />
       <TextBlock x:Name="StorageInfo" Text="Einstellungen, Kontakte und Anrufverlauf werden nur auf diesem PC gespeichert. Es werden keine Daten an externe Dienste übertragen." TextWrapping="Wrap" LineHeight="21" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12" />
       <StackPanel Orientation="Horizontal"><Button Content="Datenordner öffnen" Click="OpenDataFolder_Click" Margin="0,0,9,0" /><Button Content="Programm beenden" Click="Exit_Click" /></StackPanel>
       <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,16,0,0"><StackPanel><TextBlock Text="CM AnrufMonitor · Version 0.2.0" FontWeight="SemiBold" /><TextBlock Text="Ersteller: C. Mihalik · Eigenständige Anwendung für Windows 10 und 11" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0" /><TextBlock Text="FRITZ!Box ist eine Marke ihres jeweiligen Rechteinhabers. Diese App ist kein offizielles FRITZ!-Produkt." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,9,0,0" /></StackPanel></Border>
      </StackPanel></ScrollViewer>
     </TabItem>
    </TabControl>

    <DockPanel Grid.Row="3" Margin="0,13,0,0"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="Info" Click="Info_Click" Style="{StaticResource SmallButton}" Padding="9,3" MinHeight="25" Margin="8,0,6,0" /><Button Content="Unterstützen" Click="Support_Click" Style="{StaticResource SmallButton}" Padding="9,3" MinHeight="25" /></StackPanel><TextBlock x:Name="FooterStatus" Text="Lokal auf diesem PC · Keine Cloud-Verbindung" Style="{StaticResource MutedText}" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /></DockPanel>
   </Grid>

   <Grid x:Name="CompactContent" Grid.Row="2" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,14"><TextBlock x:Name="CompactConnection" Text="● Noch nicht verbunden" FontSize="11" Foreground="{StaticResource YellowBrush}" /><Button Content="⚙" ToolTip="Einrichtung öffnen" Click="OpenSettings_Click" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource SmallButton}" Padding="8,2" MinHeight="25" /></DockPanel>
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Background="#29112F61"><StackPanel VerticalAlignment="Center">
     <TextBlock x:Name="CompactState" Text="DEIN ANRUF-WIDGET" Foreground="{StaticResource YellowBrush}" FontSize="10" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
     <TextBlock x:Name="CompactName" Text="Bereit zur Einrichtung" FontSize="21" FontWeight="SemiBold" Margin="0,10,0,5" TextWrapping="Wrap" MaxHeight="61" TextTrimming="CharacterEllipsis" />
     <TextBlock x:Name="CompactNumber" Text="#96*5* am Telefon wählen" FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}" />
     <TextBlock x:Name="CompactDuration" Text="" FontSize="25" Margin="0,10,0,0" />
    </StackPanel></Border>
    <DockPanel Grid.Row="2" Margin="0,13,0,13"><TextBlock x:Name="CompactMissed" Text="Heute 0 verpasst" FontSize="11" Foreground="#FFB6BA" /><TextBlock x:Name="CompactTime" Text="" DockPanel.Dock="Right" FontSize="11" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" /></DockPanel>
    <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Content="Anrufverlauf" Click="OpenHistory_Click" Margin="0,0,8,0" Style="{StaticResource AccentButton}" /><Button x:Name="CompactCopyButton" Grid.Column="1" Content="Nummer kopieren" Click="CopyHero_Click" IsEnabled="False" /></Grid>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"><Button Content="Info" Click="Info_Click" Style="{StaticResource SmallButton}" Padding="8,2" MinHeight="24" Margin="0,0,6,0" /><Button Content="Unterstützen" Click="Support_Click" Style="{StaticResource SmallButton}" Padding="8,2" MinHeight="24" /></StackPanel>
   </Grid>
  </Grid>
 </Border>
</Window>
